import test, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
-- Requirement names/status and planning quotes are controlled client fixtures.
-- They test generic routing, not a factual list of tools for every game recipe.
local function setup(profession)
 local a=_G["CraftDeja"];a.options.language="de";a.showCentralGuide()
 local r={id=900001,profession=profession or 164,learned=true,confirmed=true,complete=true,liveName="Testrezept",colour="orange",yellow=100,green=120,grey=140,skill=1,points=1}
 a.active={profile={id=r.profession,skill=60,cap=150},recipes={[r.id]=r}}
 a.professionOpen=true;a.shopping.open=false;a.shopping.goal="next"
 a.decision={current={recipe=r},stop=70}
 mock.stub(a,"nativeProfessionVisible",function()return true end)
 local rows={}
 mock.stub(C_TradeSkillUI,"GetRecipeRequirements",function()return rows end)
 mock.stub(a,"canRecommend",function()return true,"known"end)
 mock.stub(a,"quote",function(recipe)return {cost=recipe.cost or 10,inputs={{item=2840,amount=1,unit=10}}}end)
 mock.stub(a,"inventoryFor",function()return {bags=0,total=0,bank=0,shared=0,alts={}}end)
 local plan={recipe=r,crafts=10,from=60,target=70,stockKnown=true,rows={{id=2840,name="Copper Bar",total=10,buy=10,owned=0,unit=10,vendor=false,locations={bags=0,total=0}}}}
 return a,r,rows,plan
end
@afterEach
local function errors()
 local e=mock.errors();assert(#e==0,table.concat(e,"\n"))
end
@test("Requirements: confirmed limited production unlocks only the next purchase slice")
local function scenario()
local a,r=setup();a.active.profile.skill=300;r.craftLimit=1
assert(a.startProduction(r,5));local plan=a.productionPlan();local key=a.purchaseKey(plan)
a.ensurePurchaseBatch(plan);a.shopping.searched=true
assert(a.purchaseKey(a.productionPlan())==key,"Unconfirmed work changed the purchase slice")
a.productionCraftEvent("player","confirmed",r.id)
local nextPlan=a.productionPlan()
assert(a.purchaseKey(nextPlan)~=key and not a.shopping.searched,"Confirmed limited craft did not advance purchase slice")
assert(a.ensurePurchaseBatch(nextPlan).rows[2840].remaining==1,"Next available craft remained blocked by old budget")
a.productionCraftEvent("player","confirmed",r.id)
assert(a.productionJob().remaining==4,"Duplicate success advanced limited production twice")

end
