import test, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
local function setup()
    local a=_G["CraftDeja"]
    a.showCentralGuide();a.shopping.goal="next";a.options.green=true
    mock.stub(a,"canRecommend",function()return true,"known"end)
    mock.stub(a,"quote",function(r)return {cost=r.cost or 10,inputs={{item=2840,amount=1,unit=r.cost or 10}}}end)
    mock.stub(a,"inventoryFor",function()return {bags=0,total=0,bank=0,shared=0,alts={}}end)
    local function recipe(id,cost,yellow,green,grey)
        return {id=id,profession=186,cost=cost,yellow=yellow,green=green,grey=grey,skill=1,
            learned=true,confirmed=true,complete=true,colour="orange",points=1,groups={{choices={2840},amount=1}}}
    end
    local r=recipe(1,10,90,110,130)
    local profile={id=186,skill=76,cap=150}
    a.active={profile=profile,recipes={[r.id]=r}}
    local snapshot=function()
        local s={profile=profile,recipes=a.active.recipes,quotes={}}
        for id,v in pairs(s.recipes)do s.quotes[id]=a.quote(v)end
        return s
    end
    return a,r,profile,recipe,snapshot
end
@afterEach
local function errors()
    local e=mock.errors();assert(#e==0,table.concat(e,"\n"))
end
local function greenSetup()
 local a,r,p,make,s=setup();p.skill=123;r.cost=6;r.colour="green";a.options.language="de"
 local other=make(2,35,200,210,220);other.colour="orange";a.active.recipes[2]=other
 a.decision=a.decide(s());assert(a.decision.stop==124,"Fixture: economic switch is not at 124")
 mock.stub(a,"inventoryFor",function()return {bags=6,total=6,bank=0,shared=0,alts={}}end)
 a.professionOpen=true;mock.stub(a,"nativeProfessionVisible",function()return true end)
 return a,r,p
end
@test("Craft forecast: 19-forecast-not-guarantee")
local function scenario()
local a,r=greenSetup();mock.setField(a,'materialStages',{['186:1:124']={recipe=1,profession=186,target=124,choices={['item:2840']={source='stock',item=2840}}}});local p=a.materialPlan(r,124)
a.renderNextStep(p,true,{kind="craft",key="green",available=6,batch=1,stop=124,body=""})
local f=a.nextStepWindow;assert(f.outputCount:GetText()==a.caption("craft_safe_forecast",1,124,6),"UI conflates one prepared attempt with forecast")
assert(f.primaryCTA:GetText()==a.caption("cta_attempt"),"Green boundary lacks attempt CTA")
end
