import test, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
local a=_G['CraftDeja']
@afterEach
local function errors()
 local e=mock.errors();assert(#e==0,table.concat(e,"\n"))
end
@test("Recipe AH cap includes exactly 15 percent and removes premium on a shared stop")
local function cap()
 assert(a.recipeBuyLimit(1000,false)==1150)
 assert(980<=a.recipeBuyLimit(1000,false) and 1151>a.recipeBuyLimit(1000,false))
 assert(1080>a.recipeBuyLimit(1000,true) and 980<=a.recipeBuyLimit(1000,true))
 assert(a.recipeBuyLimit(nil,false)==nil and a.recipeBuyLimit(1,false)==1)
end
@test("Distinct competitive routes vote for future recipes; alternatives and duplicate modes cannot inflate confidence")
local function routes()
 local function route(second,net)
  return {net=net,segments={{recipe=1,from=65,to=75},{recipe=second,from=75,to=300}}}
 end
 local best=route(2,100)
 local needs=a.forecastRecipeNeeds({best=best,candidates={best,route(2,101),route(3,109),route(4,300)}},{needsLearning=true,recipe={id=99,skill=65}})
 assert(needs[99].current and needs[1].votes==2)
 assert(needs[2].votes==1 and needs[3].votes==1 and needs[4].votes==0 and not needs[4].best)
end
@test("One green skill point buys four attempts or eight with reserve; native safe batch stays at one")
local function green()
 local r={id=991991,profession=333,learned=true,confirmed=true,skill=1,yellow=60,green=70,grey=80,colour='green',points=1}
 local inventory={[11]=0,[22]=0}
 mock.setField(a,'active',{profile={id=333,skill=75,cap=150},recipes={[r.id]=r}})
 mock.setField(a,'decision',{current={recipe=r,greenExtra=true},stop=76})
 mock.setField(a.character,'greenReserve',nil)
 mock.stub(a,'inventoryFor',function(id)return {total=inventory[id],bags=inventory[id]}end)
 mock.stub(a,'confirmedMail',function()return 0 end)
 mock.stub(a,'quote',function()return {cost=11,inputs={{item=11,amount=1,unit=3},{item=22,amount=2,unit=4}}}end)
 local p=a.materialPlan(r,76)
 assert(p.crafts==4 and p.rows[1].buy==4 and p.rows[2].buy==8 and p.reserveExtra==44)
 a.character.greenReserve={recipe=r.id,target=76}
 local extra=a.materialPlan(r,76)
 assert(extra.expectedCrafts==4 and extra.rows[1].buy==8 and extra.rows[2].buy==16)
 inventory[11]=3;inventory[22]=6
 local remaining=a.materialPlan(r,76)
 local batch=a.craftBatchInfo(remaining)
 assert(batch.available==3 and batch.count==1 and batch.estimatedCount==3 and a.nextStep(remaining).kind=='craft')
end
@test("Only a confirmed physical enchanting output can bypass target selection")
local function wand()
 assert(a.requiresEnchantTarget({profession=333,isEnchantingRecipe=true,outputItemID=77,outputFromClient=true}))
 assert(a.requiresEnchantTarget({profession=333,outputItemID=77,outputFromClient=true}))
 assert(not a.requiresEnchantTarget({profession=333,isEnchantingRecipe=false,outputItemID=77,outputFromClient=true}))
end
@test("Cooking at 219 with 33 fish offers a safe six and an explicit thirty-attempt native handoff")
local function cooking()
 local r={id=7828,profession=185,learned=true,confirmed=true,complete=true,points=1}
 local plan={recipe=r,from=219,target=225,crafts=30,expectedCrafts=30,estimated=true,rows={{id=6362,total=30,owned=33,unit=4,locations={bags=33}}}}
 mock.setField(a,'active',{profile={id=185,skill=219,cap=225},recipes={[r.id]=r}})
 mock.setField(a,'professionOpen',true);mock.setField(a.shopping,'goal','next')
 mock.setField(a,'decision',{current={recipe=r},stop=225});mock.setField(a,'nativeCraftHandoff',nil)
 mock.stub(a,'materialPlan',function()local p=a.copy(plan);p.rows={a.copy(plan.rows[1])};return p end)
 mock.stub(a,'quote',function()return {inputs={{item=6362,amount=1}}}end)
 mock.stub(a,'craftRefreshBusy',function()return false end);mock.stub(a,'nativeProfessionVisible',function()return true end)
 mock.stub(a,'craftRequirementTask',function()return nil end)
 mock.stub(a,'refresh',function()end);mock.stub(a,'refreshNextStep',function()end)
 mock.stub(a,'rodPreparationPlan',function()return nil end)
 mock.stub(a,'selectNativeRecipe',function()return true end)
 mock.stub(C_Item,'GetItemCount',function()return 33 end)
 local input={n=0};function input:SetValue(n)self.n=n end;function input:GetValue()return self.n end
 local page={SchematicForm={GetRecipeInfo=function()return {recipeID=7828}end},CreateMultipleInputBox=input,CreateButton=CreateFrame('Button',nil,UIParent)}
 mock.setField(_G,'ProfessionsFrame',{CraftingPage=page})
 assert(a.craftNext(plan,true) and input.n==6);a.clearNativeCraft()
 assert(a.craftNext(plan,'estimate') and input.n==30 and a.nativeCraftHandoff.stop==225 and not a.craftBatch)
end

@test("Cooking quest 6610: AH deficits, confirmed mail, bank, Dirge and the next rank")
local function clamlette()
 local p={id=185,skill=225,cap=225}
 mock.setField(a,'active',{profile=p,recipes={}})
 local bags={[12207]=2,[7974]=10,[8932]=0}
 local bank={[8932]=3}
 local mail={}
 local level=34
 local completed=false
 local accepted=false
 mock.stub(a,'playerLevel',function()return level end)
 mock.stub(a,'productionEnabled',function()return false end)
 mock.stub(a,'inventoryFor',function(id)return {bags=bags[id],bank=bank[id] or 0}end)
 mock.stub(C_Item,'GetItemCount',function(id)return bags[id] end)
 mock.setField(C_QuestLog,'IsQuestFlaggedCompleted',function(id)return id==6610 and completed end)
 mock.setField(C_QuestLog,'IsOnQuest',function(id)return id==6610 and accepted end)
 mock.stub(a,'confirmedMail',function(id)return mail[id] or 0 end)
 mock.stub(a,'itemName',function(id)return 'Material '..id end)
 mock.stub(a,'vendorPrice',function()return 5 end)
 mock.setField(a.shopping,'open',false)
 assert(a.rankTrainerTask().levelBlocked and not a.cookingQuestPlan())
 level=35
 local t=a.rankTrainerTask()
 assert(t.kind=='ah' and t.routePlan.ahRows==2 and t.routePlan.vendorRows==0)
 assert(t.routePlan.rows[1].buy==10 and t.routePlan.rows[3].buy==17)
 mail[12207]=4
 local _,items=a.shoppingTerms(t.routePlan)
 assert(items and items[12207].quantity==6 and items[8932].quantity==17)
 mock.stub(a,'shoppingFresh',function()return true end)
 mock.stub(a,'shoppingPricesCurrent',function()return true end)
 mock.setField(a.shopping,'prices',{[12207]=100})
 assert(a.rankTrainerTask().kind=='quest_price')
 a.shopping.prices[8932]=80
 local live=a.shoppingPlan()
 assert(live.questID==6610 and live.rows[3].unit==80 and not live.rows[3].vendor)
 mail[12207]=10;mail[8932]=17
 assert(a.rankTrainerTask().kind=='mail')
 bags[12207]=12;bags[8932]=17;mail={}
 assert(a.rankTrainerTask().kind=='bank')
 bags[8932]=20;bank={}
 t=a.rankTrainerTask();assert(t.kind=='quest_visit' and t.trainer.npc==8125 and t.trainer.map==1446)
 mock.setField(a,'guideRequested',true)
 mock.setField(a,'problem','rank_full')
 a.renderNextStep(nil,true,t)
 assert(a.nextStepWindow.primaryCTA:GetText()==a.caption('cta_map'))
 mock.click(a.nextStepWindow.primaryCTA)
 assert(WorldMapFrame:IsShown() and WorldMapFrame:GetMapID()==1446 and a.mapTarget and a.mapTarget.npc==8125)
 accepted=true;assert(a.rankTrainerTask().key~=t.key)
 completed=true;bags={}
 assert(not a.cookingQuestPlan() and a.rankTrainerTask().kind=='open')
 p.cap=300;assert(not a.atCookingQuestCap())
 p.cap=225;p.skill=224;assert(not a.atCookingQuestCap())
 p.skill=225;p.id=202;assert(not a.atCookingQuestCap())
end
