import test from "wowlua:test"
import * as mock from "wowlua:mock"

-- Each file gets a fresh client. Only recipe planning and guide routing
-- are fixtures; merchant APIs, buttons, money, bags and replies are real
-- wowlua models unless a test explicitly injects a faulty API answer.
local function setup(options)
    local c = options or {}
    c.app = _G["CraftDeja"]
    c.item = 3371
    c.before = c.before or 2
    c.goal = c.goal or 5
    c.bundle = c.bundle or 1
    c.price = c.price or 10
    c.available = c.available or -1
    c.maxStack = c.maxStack or 20
    c.money = c.money or 10000
    c.latency = c.latency or 1
    local app = c.app
    mock.defineItem(c.item, { name = "Empty Vial", stackCount = 20 })
    mock.defineItem(6947, { name = "Bag filler", stackCount = 20 })
    mock.setBag(0, { slots = 16, items = {
        [1] = { id = c.item, count = c.before }
    } })
    mock.stub(app, "refresh", function() end)
    mock.stub(app, "refreshNextStep", function() end)
    mock.stub(app, "planningTarget", function() return c.goal end)
    mock.stub(app, "materialPlan", function()
        local owned = C_Item.GetItemCount(c.item, false)
        return {
            stockKnown = type(owned) == "number",
            from = 0, target = c.goal, crafts = c.goal,
            rows = {{ id = c.item, total = c.goal,
                buy = math.max(0, c.goal - (owned or 0)),
                unit = c.price / c.bundle,
                locations = { bags = owned, total = owned, alts = {} }
            }}
        }
    end)
    local recipe = { id = 900002, learned = true }
    app.active = { profile = { id = 164, skill = 100, cap = 100 },
        recipes = { [recipe.id] = recipe } }
    app.decision = { current = { recipe = recipe } }
    mock.player:setMoney(c.money)
    mock.setLatency(c.latency)
    c.count = function() return C_Item.GetItemCount(c.item, false) end
    c.open = function()
        mock.openMerchant({ name = "CraftDeja test vendor", items = {{
            id = c.item, price = c.price, stack = c.bundle,
            available = c.available, maxStack = c.maxStack, usable = true
        }} })
        mock.waitSeconds(c.latency + 0.2)
    end
    c.show = function()
        app.offerVendorPurchase()
        local row = app.vendorPurchase.plan and app.vendorPurchase.plan.rows[1]
        assert(row, "FIXTURE: no offered ingredient")
        app.renderNextStep(nil, true, { kind = "vendor", key = "suite-vial",
            id = c.item, atVendor = true, body = "Buy missing vials" })
        local guide = app.nextStepWindow
        assert(guide and guide:IsVisible(), "Guide is not visible")
        assert(guide.vendorOffer, "Guide has no displayed offer")
        assert(guide.action:IsEnabled(), "Guide purchase button is disabled")
        c.guide = guide
        return row
    end
    c.click = function() mock.click(c.guide.action) end
    c.settle = function(expected)
        mock.waitUntil(function()
            return c.count() == expected and not app.vendorPurchase.pending
        end)
    end
    c.noPurchase = function()
        mock.waitSeconds(c.latency + 0.2)
        assert(c.count() == c.before, "Unexpected item purchase")
        assert(GetMoney() == c.money, "Unexpected money deduction")
        assert(not app.vendorPurchase.pending, "Unexpected pending purchase")
    end
    c.done = function()
        mock.closeMerchant()
        assert(#mock.errors() == 0, "Unexpected Lua error")
    end
    return c
end

@test("Full bags cannot be reported as a successful purchase")
local function scenario()

    local c=setup({before=20,goal=21})
    for bag=0,4 do
        local items={}
        for slot=1,16 do items[slot]={id=6947,count=20} end
        if bag==0 then items[1]={id=c.item,count=20} end
        mock.setBag(bag,{slots=16,items=items})
    end
    c.open();c.show();c.click();mock.waitSeconds(2)
    assert(c.count()==20, "Items appeared in full bags")
    assert(GetMoney()==10000, "Money spent without bag space")
    assert(c.app.vendorPurchase.status~="vendor_buy_done", "Failed purchase marked done")
    -- Inventory-full feedback is an expected client error message, not Lua failure.
    c.done()
end
