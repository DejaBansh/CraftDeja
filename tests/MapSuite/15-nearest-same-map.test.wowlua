import test, afterEach from "wowlua:test"
import * as mock from "wowlua:mock"
local function setup(side)
    local app=_G["CraftDeja"]
    app.showCentralGuide()
    mock.stub(_G,"UnitFactionGroup",function()return side or "Horde"end)
    mock.stub(C_Map,"GetBestMapForUnit",function()return 1454 end)
    mock.stub(C_Map,"GetPlayerMapPosition",function()return {x=.5,y=.4,GetXY=function()return .5,.4 end}end)
    return app,{id=7748,profession=333,learned=false,green=120,grey=140}
end
@afterEach
local function errors()
    local e=mock.errors();assert(#e==0,table.concat(e,"\n"))
end
@test("Recipe map: 15-nearest-same-map")
local function scenario()
local a,r=setup();mock.setField(a.accessData,r.id,{routes={{id=1,kind="trainer",name="Far",side="Horde",map=1454,x=80,y=90},{id=2,kind="trainer",name="Near",side="Horde",map=1454,x=51,y=41},{id=3,kind="trainer",name="Other map",side="Horde",map=1458,x=50,y=40}}})
assert(a.recipeSourceTarget(r).npc==2,"Wrong nearest source")
end
